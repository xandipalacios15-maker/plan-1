# Archivo ilustrativo. Django NO lo carga automáticamente. Exporta estas variables.
# Genera un valor único: python -c 'import secrets; print(secrets.token_urlsafe(64))'
APP_SECRET_KEY=
# Solo para desarrollo local. En despliegue usa 0 y HTTPS.
APP_DEBUG=1
APP_ALLOWED_HOSTS=localhost,127.0.0.1
